---
import { loadQuery } from "../sanity/lib/load-query";
import Layout from '../layouts/Layout.astro';

// Import all of our modular sections
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Spotlight from '../components/Spotlight.astro';
import Integrations from '../components/Integrations.astro';
import BottomCta from '../components/BottomCta.astro';
import Footer from '../components/Footer.astro';

// Expanded GROQ Query mapping to fetch both Landing Page AND Site Settings!
const query = `{
  "pageData": *[_id == "homePage"][0]{
    metaTitle,
    metaDescription,
    "ogImageUrl": openGraphImage.asset->url,
    sectionHero {
      eyebrow, heading, subheading, ctaText,
      "imageUrl": heroImage.asset->url
    },
    sectionFeatures {
      eyebrow, heading,
      featureCards[]{
        title,
        description,
        linkText,
        "iconUrl": icon.asset->url
      }
    },
    sectionHighlight {
      eyebrow,
      heading,
      "imageUrl": featureImage.asset->url
    },
    sectionIntegrations {
      eyebrow, heading,
      integrationCards[]{
        name, description,
        "logoUrl": logo.asset->url
      }
    },
    sectionBottomCta {
      heading,
      subheading,
      ctaText
    }
  }
}`;

const { data: { pageData } } = await loadQuery<any>({ query });
---

<!DOCTYPE html>
<Layout
  metaTitle={pageData?.metaTitle}
  metaDescription={pageData?.metaDescription}
  openGraphImage={pageData?.ogImageUrl}
>
    <Navbar />
    <main class="main">
      {pageData?.sectionHero && <Hero hero={pageData.sectionHero} />}
      
      {pageData?.sectionFeatures && <Features features={pageData.sectionFeatures} />}
      
      {pageData?.sectionHighlight && <Spotlight highlight={pageData.sectionHighlight} />}
      
      {pageData?.sectionIntegrations && <Integrations integrations={pageData.sectionIntegrations} />}
      
      {pageData?.sectionBottomCta && <BottomCta bottomCta={pageData.sectionBottomCta} />}
    </main>
    <Footer />
</Layout>