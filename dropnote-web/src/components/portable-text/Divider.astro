---
import { stegaClean } from "@sanity/client/stega";

const { node } = Astro.props;
const style = stegaClean(node.style) || "line";
---

{style === "space" ? <div class="pt-divider is-space" aria-hidden="true"></div> : <hr class={`pt-divider is-${style}`} />}

<style>
  .pt-divider {
    margin: 3rem 0;
    border: 0;
  }
  .pt-divider.is-line {
    border-top: 1px solid var(--neutral--100);
  }
  .pt-divider.is-dots {
    text-align: center;
    color: var(--neutral--light-gray);
    letter-spacing: 1em;
  }
  .pt-divider.is-dots::before {
    content: "•••";
  }
  .pt-divider.is-space {
    height: 2rem;
  }
</style>
