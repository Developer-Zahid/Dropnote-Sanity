---
import { PortableText } from "astro-portabletext";
import { stegaClean } from "@sanity/client/stega";
import { markComponents } from "./marks";

const { node } = Astro.props;
const tone = stegaClean(node.tone) || "info";

const labels: Record<string, string> = {
  info: "Note",
  tip: "Tip",
  success: "Success",
  warning: "Warning",
  danger: "Important",
};
---

<aside class={`pt-callout is-${tone}`} aria-label={node.title || labels[tone] || "Note"}>
  <p class="pt-callout__title">{node.title || labels[tone]}</p>
  <div class="pt-callout__body">
    <PortableText value={node.body ?? []} components={{ mark: markComponents }} />
  </div>
</aside>

<style>
  .pt-callout {
    --tone: var(--neutral--primary-blue);
    --tone-bg: var(--neutral--blue-50);
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--tone);
    border-radius: 0.5rem;
    background: var(--tone-bg);
  }
  .pt-callout.is-tip {
    --tone: #7c3aed;
    --tone-bg: #f5f0ff;
  }
  .pt-callout.is-success {
    --tone: #15803d;
    --tone-bg: #effaf3;
  }
  .pt-callout.is-warning {
    --tone: #b45309;
    --tone-bg: #fff8eb;
  }
  .pt-callout.is-danger {
    --tone: #b91c1c;
    --tone-bg: #fef2f2;
  }
  .pt-callout__title {
    margin: 0 0 0.375rem;
    font-weight: 600;
    color: var(--tone);
  }
  /* Tighter spacing than body copy inside the box */
  .pt-callout__body :global(p),
  .pt-callout__body :global(li) {
    margin-bottom: 0.5rem;
    font-size: 1rem;
    color: var(--neutral--dark);
  }
  .pt-callout__body :global(:last-child) {
    margin-bottom: 0;
  }
</style>
