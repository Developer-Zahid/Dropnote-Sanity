---
import { loadQuery } from "../sanity/lib/load-query";
import { Image } from 'astro:assets';

// Fetch dynamic navbar logo
const query = `{
  "settings": *[_id == "siteSettings"][0]{
    "navbarLogoUrl": navbarLogo.asset->url
  }
}`;

const { data: { settings } } = await loadQuery<any>({ query });

// Accept the logo url as a prop from the parent page;
const { logoUrl } = Astro.props;

// Set a default fallback image path pointing directly to the public folder
const finalLogo = logoUrl || settings?.navbarLogoUrl || "/assets/images/dropnote-logo.svg";

// Astro's <Image> cannot process SVGs, and the local fallback lives in /public
// (already optimised, nothing to transform). Only hand remote raster images to
// <Image>; everything else renders as a plain <img>.
const optimizable = finalLogo.startsWith("http") && !finalLogo.endsWith(".svg");
---

<nav class="nav-component u-spacing-inline">
  <div class="container">
    <div class="nav-content u-display-flex">
      <a href="/" aria-current="page" class="logo-link-block">
        {optimizable ? (
          <Image 
            src={finalLogo}
            width={168}
            height={32}
            loading="eager"
            alt="Dropnote Logo"
            class="nav-logo"
          />
        ) : (
          <img src={finalLogo} width="168" height="32" loading="eager" alt="Dropnote Logo" class="nav-logo" />
        )}
      </a>
      <div class="nav-button">
        <a href="#join-the-waitlist" class="button cc-nav">
          <div>Join the waitlist</div>
        </a>
      </div>
    </div>
  </div>
</nav>