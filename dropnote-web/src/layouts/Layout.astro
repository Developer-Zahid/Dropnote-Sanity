---
import { loadQuery } from "../sanity/lib/load-query";
import { VisualEditing } from "@sanity/astro/visual-editing";
import '../assets/styles/global.css';

// interface Props {
//   title?: string;
//   description?: string;
//   ogImage?: string;
//   favicon?: string;
//   visualEditingEnabled?: boolean;
// }

// Fetch dynamic footer logo
const query = `{
  "settings": *[_id == "siteSettings"][0]{
    metaTitle,
    metaDescription,
    "openGraphImage": openGraphImage.asset->url,
    "favicon": favicon.asset->url
  }
}`;

const { data: { settings } } = await loadQuery<any>({ query });

const visualEditingEnabled = import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === "true";

// Page-level props win, but fall back to Site Settings whenever they are
// missing, null OR an empty string (GROQ returns null for unset fields, which
// would otherwise slip past a destructuring default and render empty meta tags).
const props = Astro.props;

const metaTitle = props.metaTitle || settings?.metaTitle;
const metaDescription = props.metaDescription || settings?.metaDescription;
const openGraphImage = props.openGraphImage || settings?.openGraphImage;
const favicon = props.favicon || settings?.favicon || "/favicon.ico";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Dynamic SEO and Meta Tags -->
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    {openGraphImage && <meta property="og:image" content={openGraphImage} />}
    
    <!-- Dynamic Favicons -->
    <link rel="shortcut icon" href={favicon} />
</head>
<body>
  <div class="page-wrapper">
    <slot />
  </div>
  <VisualEditing enabled={visualEditingEnabled} zIndex={1000} />
</body>
</html>